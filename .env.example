# ============================================================
# my-agent 配置模板：复制本文件为 .env 后填写
# 环境变量优先级高于 .env 文件
# ============================================================

# ---- 选择接入哪个服务：glm | ollama | openai ----
AGENT_PROVIDER=glm

# ---- 智谱 GLM（https://open.bigmodel.cn 控制台获取 Key）----
GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-flash        # 免费款；可换 glm-4.6 等更强模型

# ---- 本地 Ollama（需先安装并 pull 支持工具调用的模型）----
# AGENT_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_API_KEY=ollama        # 本地服务不需要真实 Key，占位即可

# ---- 任意 OpenAI 兼容服务（以 DeepSeek 为例）----
# AGENT_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# ---- Agent 循环参数 ----
# AGENT_MAX_ITERATIONS=15      # 每轮最多「模型-工具」循环次数
# AGENT_TEMPERATURE=0.4        # 采样温度：Agent 场景建议低温（0~0.6），调高易语言漂移
